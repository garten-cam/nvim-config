{
  "Begin environment": {
    "prefix": "beg",
    "body": ["\\begin{$1}", "\t$0", "\\end{$1}"],
    "description": "Generic environment"
  },
  "Inline math": {
    "prefix": "mk",
    "body": "\\($1\\)$0",
    "description": "Inline math"
  },
  "Display math": {
    "prefix": "dm",
    "body": ["\\[", "\t$1", "\\]$0"],
    "description": "Display math"
  },
  "Fraction": {
    "prefix": "frac",
    "body": "\\frac{$1}{$2}$0"
  },
  "Align environment": {
    "prefix": "ali",
    "body": ["\\begin{align*}", "\t$1", "\\end{align*}"]
  }
}
